{
  "name": "wishlist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/db-provider.mjs to auto && prisma generate && next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/db-provider.mjs to sqlite && rm -f prisma/dev.db && prisma db push && npm run db:seed",
    "setup": "node scripts/db-provider.mjs to sqlite && prisma generate && prisma db push && npm run db:seed",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:db": "DATABASE_URL=file:./.test-data/test.db prisma db push --skip-generate && DATABASE_URL=file:./.test-data/test.db vitest run",
    "prices": "tsx scripts/check-prices.ts",
    "db:sqlite": "node scripts/db-provider.mjs to sqlite",
    "db:postgres": "node scripts/db-provider.mjs to postgresql",
    "db:provider": "node scripts/db-provider.mjs show",
    "db:deploy": "node scripts/db-deploy.mjs",
    "extension:build": "node scripts/build-extension.mjs",
    "test:extension": "node scripts/extension-regress.mjs"
  },
  "dependencies": {
    "@prisma/client": "^6.16.2",
    "bcryptjs": "^3.0.2",
    "lucide-react": "^1.49.0",
    "next": "^16.3.7",
    "next-auth": "5.0.0-beta.32",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.14",
    "@types/node": "^22.18.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "prisma": "^6.16.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.20.6",
    "typescript": "^5.9.2",
    "vitest": "^3.2.7"
  }
}
