# Copy to `.env` and fill in. `.env` is gitignored — never commit real secrets.
#
#   cp .env.example .env

# ---------------------------------------------------------------- database
# Local dev uses SQLite. The file is created by `npm run db:push`.
DATABASE_URL="file:./dev.db"

# In production, switch the provider first, then use a POOLED connection string.
# Serverless platforms open a new connection per instance, which exhausts the
# database's connection limit — the `-pooler` / `:6543` endpoint is what stops
# that. Neon: postgresql://USER:PASS@ep-xxx-pooler/DB?sslmode=require
#   npm run db:postgres   # rewrites the datasource provider
#   npm run db:deploy     # applies prisma/migrations to that database
DATABASE_URL_POOLER=""

# ------------------------------------------------------------------- auth
# REQUIRED in production. Generate with: openssl rand -base64 32
# Leaving this unset means sessions are signed with a build-time constant, so
# anyone can forge a session cookie.
AUTH_SECRET=""

# Set to "true" when running behind a trusted proxy (Vercel, Fly, nginx, etc.)
# so Auth.js can infer the protocol and host instead of reading the proxy's
# internal values.
AUTH_TRUST_HOST="true"

# Google sign-in. Both values are required; the button hides itself without them.
# The redirect URI must be https://YOUR-DOMAIN/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ------------------------------------------------------------------- email
# Without a key, mail is written to `.outbox/` and logged instead of sent, so
# verification and password-reset links are unreadable. Set this before letting
# anyone sign up, or they will not be able to reset a forgotten password.
RESEND_API_KEY=""

# ------------------------------------------------------------------ public
# Used for Open Graph / Twitter cards and for links inside emails. Without it
# both fall back to http://localhost:3000, so shared lists preview with a
# localhost URL when pasted into iMessage, Slack, or WhatsApp.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ------------------------------------------------------------------ framing
# ONLY ever "true" for the sandboxed live preview, which renders the app inside
# a cross-site iframe. Leave it unset or "false" everywhere else: allowing any
# site to frame the app is a clickjacking hole, because a hostile page can
# overlay invisible UI on a signed-in session.
# Allow this app to be embedded in an iframe. Leave empty in production.
# The live preview is rendered inside a cross-site iframe and needs this.
# For `next start` this is BUILD-time only: `headers()` is baked in by
# `next build`, so setting it on the running server does nothing.
ALLOW_FRAMING=""

# ------------------------------------------------------------- cookies
# "true" switches the session cookie to SameSite=None; Secure so it survives a
# third-party iframe. That requires HTTPS, so plain http:// browsers then refuse
# to store it. Use "false" (the default) for normal local dev and production.
IFRAME_SAFE_COOKIES=""

# ----------------------------------------------------------- rate limiting
# The in-memory limiter resets on every deploy and is per-instance, so it is
# effective only on a single long-running process. Point this at a shared store
# (Upstash, Redis) and see src/lib/rate-limit.ts before going multi-instance.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ------------------------------------------------------------- price checks
# Server-side price fetching is blocked by most retailers. A scraping service
# makes "Check now" return real numbers; without one the endpoint honestly
# reports that no price was served and records nothing.
SCRAPER_API_URL=""
SCRAPER_API_KEY=""

# -------------------------------------------------------------- affiliate
# Optional. A network + campaign id, used to tag outbound "buy this gift"
# links. Leave blank and the app behaves exactly as before, with no affiliate
# rewriting and no disclosure banner. See AFFILIATE_DISCLOSURE and the README.
AFFILIATE_NETWORK=""
AFFILIATE_ENABLED="false"
# Required in the UK/EU: shown next to any link that may earn commission.
AFFILIATE_DISCLOSURE="Some links are affiliate links — we may earn a commission at no extra cost to you."

# -------------------------------------------------- chrome extension build
# Stamped into extension/background.js and extension/manifest.json so an
# installed copy is already pointed at the right host. Run:
#   WISHING_WELL_ORIGIN=https://YOUR-DOMAIN npm run extension:build
WISHING_WELL_ORIGIN="http://localhost:3000"
